POSTGRES_DB=solarplan
POSTGRES_USER=solarplan
POSTGRES_PASSWORD=solarplan_local_password
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
SOLARPLAN_ENVIRONMENT=development
SOLARPLAN_DATABASE_URL=postgresql+asyncpg://solarplan:solarplan_local_password@db:5432/solarplan
SOLARPLAN_CORS_ORIGINS=["http://localhost:5173"]
SOLARPLAN_JWT_SECRET=local-development-secret-change-before-deployment
SOLARPLAN_ACCESS_TOKEN_EXPIRE_MINUTES=30
SOLARPLAN_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
SOLARPLAN_GEOCODING_USER_AGENT=SolarPlan/0.1 (https://github.com/przuljp/SolarPlan)
SOLARPLAN_GEOCODING_REFERER=https://github.com/przuljp/SolarPlan
SOLARPLAN_GEOCODING_TIMEOUT_SECONDS=10
SOLARPLAN_GEOCODING_MIN_INTERVAL_SECONDS=1
SOLARPLAN_GEOCODING_CACHE_TTL_SECONDS=3600
SOLARPLAN_PVGIS_BASE_URL=https://re.jrc.ec.europa.eu/api/v5_3
SOLARPLAN_PVGIS_VERSION=5.3
SOLARPLAN_PVGIS_TIMEOUT_SECONDS=20
SOLARPLAN_PVGIS_MAX_RETRIES=2
SOLARPLAN_PVGIS_RETRY_BACKOFF_SECONDS=0.5
SOLARPLAN_PVGIS_DEFAULT_SYSTEM_LOSS_PERCENT=14
# Backend only. Leave empty to keep AI explanations unavailable.
SOLARPLAN_OPENAI_API_KEY=
SOLARPLAN_OPENAI_MODEL=gpt-5-mini
SOLARPLAN_OPENAI_TIMEOUT_SECONDS=60
SOLARPLAN_OPENAI_MAX_OUTPUT_TOKENS=4000
VITE_API_URL=http://localhost:8000/api/v1
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

